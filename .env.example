# Set these as Netlify environment variables on the dashboard site. NEVER commit real values.

# Base URL of your Netlify Usage API deployment (the opaque URL you were given).
USAGE_API_URL=https://insights-xxxxxxxxxxxx.netlify.app

# The API key you were issued for the usage API. Stays server-side in the proxy function
# and never reaches the browser; mark it as a secret in Netlify. Comma-separate if you
# were issued more than one (the proxy uses the first).
# NOTE: with the key held server-side, anyone who can reach the dashboard URL can read
# the data. Keep the URL private or add Netlify site protection.
CUSTOMER_API_KEY=
