# Set this as a Netlify environment variable on the dashboard site.

# Base URL of your Netlify Usage API deployment (the opaque URL you were given).
# This is the ONLY server-side configuration. Your CUSTOMER_API_KEY is never stored
# anywhere in this app; viewers enter it in the dashboard and it is sent with each
# request, authenticated by the usage API itself.
USAGE_API_URL=https://insights-xxxxxxxxxxxx.netlify.app
