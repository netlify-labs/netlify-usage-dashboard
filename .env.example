# Set these as Netlify environment variables on the dashboard site. NEVER commit real values.

# Base URL of your Netlify Usage API deployment (the opaque URL you were given).
USAGE_API_URL=https://insights-xxxxxxxxxxxx.netlify.app

# The API key you were issued for the usage API. Stays server-side in the proxy function;
# it is never sent to the browser. Comma-separate if you were issued more than one.
CUSTOMER_API_KEY=

# RECOMMENDED. A key of your own choosing that viewers must enter to use this dashboard.
# Without it, anyone who finds the dashboard URL can read your usage data through the proxy.
# Comma-separate to keep two keys active while rotating. Generate with: openssl rand -hex 24
DASHBOARD_ACCESS_KEY=
